# ── Uzum Seller OpenAPI ──────────────────────────────────────────────
# Bazaviy manzil (odatda o'zgartirish shart emas)
UZUM_API_BASE=https://api-seller.uzum.uz
UZUM_API_PREFIX=/api/seller-openapi

# API token — https://seller.uzum.uz/seller/api-keys sahifasidan olinadi.
# Login/parol to'g'ri kiritilgach, server shu tokenni brauzerga bir marta beradi.
UZUM_API_TOKEN=

# ── Ilova kirish (login/parol) ───────────────────────────────────────
# Foydalanuvchi xom API token o'rniga shu login/paroldan foydalanadi.
APP_LOGIN=
APP_PASSWORD=

# ── Serverlar ────────────────────────────────────────────────────────
PORT_DEV=5173
PORT=3000

# Production'da proxy'ga kim murojaat qila oladi (vergul bilan)
CORS_ORIGIN=http://localhost:5173
